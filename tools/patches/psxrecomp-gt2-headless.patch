+/* GT2 headless VRAM dump: when GT2_AUTO_DUMP=1, writes a PNG of the current
+ * display every N frames so the menu flow can be inspected without a window.
+ * Files are written to the cwd as gt2_dump_<frame>.png. */
+static void gt2_headless_dump_vram(void) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *e = std::getenv("GT2_AUTO_DUMP");
+        enabled = (e && *e && *e != '0') ? 1 : 0;
+    }
+    if (!enabled) return;
+    extern uint64_t s_frame_count;
+    uint64_t f = s_frame_count;
+    static uint64_t last_dump = 0;
+    extern int fntrace_is_game_started(void);
+    if (!fntrace_is_game_started()) return;
+    if (f < 6000) return;
+    /* Fast cadence (every 300 frames) during menu navigation (6000-15000),
+     * slow cadence (every 1200 frames) once we should be in a race. */
+    uint64_t interval = (f < 15000) ? 300 : 1200;
+    if (f - last_dump < interval) return;
+    last_dump = f;
+    GpuDisplayInfo di;
+    gpu_get_display_info(&di);
+    if (di.disabled || di.width == 0 || di.height == 0) return;
+    uint32_t w = di.width;  if (w > 640) w = 640;
+    uint32_t h = di.height; if (h > 512) h = 512;
+    uint8_t *rgb = (uint8_t *)malloc((size_t)w * h * 3);
+    if (!rgb) return;
+    for (uint32_t y = 0; y < h; y++)
+        for (uint32_t x = 0; x < w; x++) {
+            uint8_t r, g, b;
+            gpu_display_pixel_rgb(&di, x, y, &r, &g, &b);
+            size_t i = ((size_t)y * w + x) * 3;
+            rgb[i] = r; rgb[i+1] = g; rgb[i+2] = b;
+        }
+    char path[256];
+    std::snprintf(path, sizeof(path), "gt2_dump_%08llu.png", (unsigned long long)f);
+    FILE *fp = std::fopen(path, "wb");
+    if (fp) {
+        png_write_rgb(fp, rgb, w, h);
+        std::fclose(fp);
+        std::fprintf(stderr, "[gt2_dump] frame %llu -> %s (%ux%u)\n",
+                     (unsigned long long)f, path, w, h);
+    }
+    free(rgb);
+}
